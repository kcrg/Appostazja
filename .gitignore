# =============================================================================
# Repository-wide ignores: .NET, Android/Kotlin, Swift/Xcode
# =============================================================================

# OS / editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
.vs/

# Logs / temporary files
*.log
*.tmp
*.temp
*.bak
*.orig

# =============================================================================
# .NET / Visual Studio / Rider
# =============================================================================
**/[Bb]in/
**/[Oo]bj/
**/[Aa]rtifacts/
**/[Tt]est[Rr]esults*/
**/[Bb]enchmark[Dd]ot[Nn]et.[Aa]rtifacts/

*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
*.binlog
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
nunit-*.xml

# NuGet / publish output
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
**/[Pp]ackages/*
!**/[Pp]ackages/build/
[Pp]ublish/
*.pubxml
*.pubxml.user
*.publishproj

# Native/AOT/debug artifacts
*.pdb
*.ipdb
*.iobj
*.obj
*.ilk
*.pgc
*.pgd
*.rsp
*.dmp

# Local API/runtime data
/src/Appostazja.DotNet/Appostazja.Api/[Dd]ata/*.db
/src/Appostazja.DotNet/Appostazja.Api/[Dd]ata/*.db-*

# =============================================================================
# Android / Kotlin / Gradle
# =============================================================================
.gradle/
.kotlin/
**/build/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/
.navigation/

# Android packaging/signing outputs
*.apk
*.aab
*.ap_
*.dex
*.class

# Keep signing material out of new commits
*.jks
*.keystore

# =============================================================================
# Swift / Xcode / Swift Package Manager
# =============================================================================
DerivedData/
.build/
.buildServer.json

# Xcode user state
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# SwiftPM local IDE metadata (Package.resolved should stay tracked for apps)
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/configuration/registries.json

# CocoaPods / Carthage generated dependencies
Pods/
Carthage/Build/

# Apple signing / provisioning secrets
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# =============================================================================
# Misc tooling
# =============================================================================
_ReSharper*/
*.[Rr]e[Ss]harper
.localhistory/
.history/
