	<attr path="/api/package[@name='com.google.maps.android.ui']" name="managedName">Android.Gms.Maps.Utils.UI</attr>
	<attr path="/api/package[@name='com.google.maps.android.data']" name="managedName">Android.Gms.Maps.Utils.Data</attr>
	<attr path="/api/package[@name='com.google.maps.android.data.kml']" name="managedName">Android.Gms.Maps.Utils.Data.Kml</attr>
	<attr path="/api/package[@name='com.google.maps.android.quadtree']" name="managedName">Android.Gms.Maps.Utils.Quadtree</attr>
	<attr path="/api/package[@name='com.google.maps.android.geometry']" name="managedName">Android.Gms.Maps.Utils.Geometry</attr>
	<attr path="/api/package[@name='com.google.maps.android.heatmaps']" name="managedName">Android.Gms.Maps.Utils.HeatMaps</attr>
	<attr path="/api/package[@name='com.google.maps.android.projection']" name="managedName">Android.Gms.Maps.Utils.Projection</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering']" name="managedName">Android.Gms.Maps.Utils.Clustering</attr>
