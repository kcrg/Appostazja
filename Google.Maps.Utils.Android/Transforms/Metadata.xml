	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']" name="managedName">Android.Gms.Maps.Utils.Clustering.Algorithm</attr>

	<!-- Fix Layer visibility issues (CS0507) -->
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Layer']/method[@name='hasContainers' and count(parameter)=0]"
		  name="visibility">public</attr>
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Layer']/method[@name='getContainers' and count(parameter)=0]"
		  name="visibility">public</attr>
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Layer']/method[@name='getGroundOverlays' and count(parameter)=0]"
		  name="visibility">public</attr>

	<!-- Fix Algorithm<T> methods (CS0534 etc.) -->
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/interface[@name='Algorithm']/method[@name='addItem' and count(parameter)=1 and parameter[1][@type='T']]/parameter[1]"
		  name="type">java.lang.Object</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/interface[@name='Algorithm']/method[@name='removeItem' and count(parameter)=1 and parameter[1][@type='T']]/parameter[1]"
		  name="type">java.lang.Object</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/interface[@name='Algorithm']/method[@name='updateItem' and count(parameter)=1 and parameter[1][@type='T']]/parameter[1]"
		  name="type">java.lang.Object</attr>

	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='GridBasedAlgorithm']/method[@name='addItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='ScreenBasedAlgorithmAdapter']/method[@name='addItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='PreCachingAlgorithmDecorator']/method[@name='addItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='NonHierarchicalDistanceBasedAlgorithm']/method[@name='addItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>

	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='GridBasedAlgorithm']/method[@name='removeItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='ScreenBasedAlgorithmAdapter']/method[@name='removeItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='PreCachingAlgorithmDecorator']/method[@name='removeItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='NonHierarchicalDistanceBasedAlgorithm']/method[@name='removeItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>

	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='GridBasedAlgorithm']/method[@name='updateItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='ScreenBasedAlgorithmAdapter']/method[@name='updateItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='PreCachingAlgorithmDecorator']/method[@name='updateItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<attr path="/api/package[@name='com.google.maps.android.clustering.algo']/class[@name='NonHierarchicalDistanceBasedAlgorithm']/method[@name='updateItem' and count(parameter)=1]"
		  name="managedOverride">override</attr>

	<!-- RotationLayout.dispatchDraw(Canvas): must be protected override -->
	<attr path="/api/package[@name='com.google.maps.android.ui']/class[@name='RotationLayout']/method[@name='dispatchDraw' and count(parameter)=1 and parameter[1][@type='android.graphics.Canvas']]"
		  name="visibility">protected</attr>
	<attr path="/api/package[@name='com.google.maps.android.ui']/class[@name='RotationLayout']/method[@name='dispatchDraw' and count(parameter)=1 and parameter[1][@type='android.graphics.Canvas']]"
		  name="managedOverride">override</attr>

	<!-- MapObjectManager -->
	<attr path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager']"
		  name="visibility">public</attr>

	<!-- Remove generic/abstract pieces from MapObjectManager (noise + binding issues) -->
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager']/method[@name='removeObjectFromMap' and count(parameter)=1]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager']/method[@name='newCollection' and count(parameter)=0]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager']/method[@name='newCollection' and count(parameter)=1 and parameter[1][@type='java.lang.String']]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager']/method[@name='getCollection' and count(parameter)=1 and parameter[1][@type='java.lang.String']]" />

	<!-- MapObjectManager.Collection: remove generic O methods (BG8800/BG8701) -->
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager$Collection' or @name='MapObjectManager.Collection']/method[@name='add' and count(parameter)=1]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager$Collection' or @name='MapObjectManager.Collection']/method[@name='remove' and count(parameter)=1]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class[@name='MapObjectManager$Collection' or @name='MapObjectManager.Collection']/method[@name='getObjects' and count(parameter)=0]" />

	<!-- Fix CS0111 duplicates by removing bridge/synthetic newCollection/getCollection -->
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class/method[@name='newCollection' and (@bridge='true' or @synthetic='true')]" />
	<remove-node path="/api/package[@name='com.google.maps.android.collections']/class/method[@name='getCollection' and (@bridge='true' or @synthetic='true')]" />

	<!-- C# overrides must keep the same visibility; expose the Java base hooks publicly. -->
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Feature']/method[@name='removeProperty' and count(parameter)=1]"
		  name="visibility">public</attr>
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Feature']/method[@name='setGeometry' and count(parameter)=1]"
		  name="visibility">public</attr>
	<attr path="/api/package[@name='com.google.maps.android.data']/class[@name='Feature']/method[@name='setProperty' and count(parameter)=2]"
		  name="visibility">public</attr>

	<!-- GeoJsonFeature widens the protected Java methods inherited from Feature to public. -->
	<attr path="/api/package[@name='com.google.maps.android.data.geojson']/class[@name='GeoJsonFeature']/method[@name='removeProperty' and count(parameter)=1]"
		  name="managedOverride">override</attr>
	<remove-node path="/api/package[@name='com.google.maps.android.data.geojson']/class[@name='GeoJsonFeature']/method[@name='setGeometry' and count(parameter)=1]" />
	<attr path="/api/package[@name='com.google.maps.android.data.geojson']/class[@name='GeoJsonFeature']/method[@name='setProperty' and count(parameter)=2]"
		  name="managedOverride">override</attr>

</metadata>
