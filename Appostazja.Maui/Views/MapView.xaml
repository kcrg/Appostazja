<?xml version="1.0" encoding="UTF-8" ?>
<base:BasePage
    x:Class="Appostazja.Maui.Views.MapView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:base="clr-namespace:Appostazja.Maui.Views.Base"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:models="clr-namespace:Appostazja.Maui.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Appostazja.Maui.ViewModels"
    SafeAreaEdges="None"
    Title="Mapa"
    Shell.NavBarIsVisible="False"
    android:NavigationBar.Color="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
    android:NavigationBar.Style="{AppThemeBinding Light=DarkContent, Dark=LightContent}"
    x:DataType="vm:MapViewModel">

    <base:BasePage.Behaviors>
        <toolkit:StatusBarBehavior
            ApplyOn="OnPageNavigatedTo"
            StatusBarColor="Transparent"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </base:BasePage.Behaviors>

    <Grid toolkit:StateContainer.CurrentState="{Binding CurrentState}">
        <toolkit:StateContainer.StateViews>
            <Border
                Margin="32"
                toolkit:StateView.StateKey="Loading"
                HorizontalOptions="Center"
                Style="{StaticResource ElevatedCardStyle}"
                VerticalOptions="Center">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" />
                    <Label
                        Style="{StaticResource TitleMediumStyle}"
                        Text="Pobieram dane mapy…"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border
                Margin="24"
                toolkit:StateView.StateKey="Error"
                Style="{StaticResource ElevatedCardStyle}"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <Image HeightRequest="44" HorizontalOptions="Center" WidthRequest="44">
                        <Image.Source>
                            <FontImageSource
                                Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                                FontFamily="{StaticResource FontIcons}"
                                Glyph="{StaticResource IconAlertCircle}"
                                Size="42" />
                        </Image.Source>
                    </Image>
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource TitleLargeStyle}"
                        Text="Nie udało się wczytać mapy" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyMediumStyle}"
                        Text="{Binding ErrorMessage}" />
                    <Button
                        Command="{Binding RetryCommand}"
                        HorizontalOptions="Fill"
                        Text="Spróbuj ponownie" />
                </VerticalStackLayout>
            </Border>
        </toolkit:StateContainer.StateViews>

        <maps:Map
            x:Name="ApostasyMap"
            IsScrollEnabled="True"
            IsZoomEnabled="True"
            ItemsSource="{Binding ChurchPins}"
            MapClicked="OnMapClicked">
            <maps:Map.ItemTemplate>
                <DataTemplate x:DataType="models:ChurchMapPin">
                    <maps:Pin
                        Address="{Binding Address}"
                        Label="{Binding Label}"
                        ImageSource="{Binding PinImageSource}"
                        Location="{Binding Location}"
                        MarkerClicked="OnMarkerClicked" />
                </DataTemplate>
            </maps:Map.ItemTemplate>
        </maps:Map>

        <Border
            Margin="16,48,16,0"
            Padding="14,10"
            HorizontalOptions="Fill"
            VerticalOptions="Start"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            ZIndex="2">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Image HeightRequest="28" WidthRequest="28">
                        <Image.Source>
                            <FontImageSource
                                Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                FontFamily="{StaticResource FontIcons}"
                                Glyph="{StaticResource IconMapPins}"
                                Size="26" />
                        </Image.Source>
                    </Image>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Style="{StaticResource TitleMediumStyle}" Text="Parafie na mapie" />
                        <Label
                            Style="{StaticResource SupportingTextStyle}"
                            Text="{Binding TotalChurchCount, StringFormat='Załadowano {0} punktów'}" />
                        <Label
                            Style="{StaticResource SupportingTextStyle}"
                            Text="{Binding DataUpdatedText}" />
                    </VerticalStackLayout>
                    <Grid Grid.Column="2">
                        <Button
                            Command="{Binding RefreshDataCommand}"
                            HeightRequest="52"
                            Padding="6"
                            SemanticProperties.Description="Aktualizuj dane mapy"
                            Style="{StaticResource TextButtonStyle}"
                            WidthRequest="52">
                            <Button.ImageSource>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconRefresh}"
                                    Size="30" />
                            </Button.ImageSource>
                        </Button>
                        <ActivityIndicator
                            HeightRequest="28"
                            InputTransparent="True"
                            IsRunning="{Binding IsRefreshing}"
                            IsVisible="{Binding IsRefreshing}"
                            WidthRequest="28" />
                    </Grid>
                </Grid>
                <Label
                    IsVisible="{Binding HasDataStatusMessage}"
                    Style="{StaticResource ErrorLabelStyle}"
                    Text="{Binding DataStatusMessage}" />
            </VerticalStackLayout>
        </Border>

        <Border
            x:Name="ChurchDetailsCard"
            Opacity="0"
            Scale="0.98"
            TranslationY="48"
            Margin="16,0,16,16"
            Padding="18"
            HorizontalOptions="Fill"
            IsVisible="{Binding HasSelectedChurch}"
            Style="{StaticResource ElevatedCardStyle}"
            VerticalOptions="End"
            ZIndex="4">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Style="{StaticResource TitleLargeStyle}"
                            Text="{Binding SelectedChurch.Label}" />
                        <Label
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Style="{StaticResource BodyMediumStyle}"
                            Text="{Binding SelectedChurch.Address}" />
                        <HorizontalStackLayout Spacing="8">
                            <toolkit:RatingView
                                EmptyShapeColor="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}"
                                FillColor="#F9A825"
                                FillOption="Shape"
                                IsReadOnly="True"
                                MaximumRating="5"
                                Rating="{Binding SelectedChurch.DisplayRating}"
                                Shape="Star"
                                ShapeBorderColor="#F9A825"
                                ShapeBorderThickness="1"
                                ShapeDiameter="18"
                                Spacing="2" />
                            <Label
                                Style="{StaticResource SupportingTextStyle}"
                                Text="{Binding SelectedChurch.RatingText}"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Clicked="OnCloseDetailsClicked"
                        HeightRequest="44"
                        Padding="8"
                        SemanticProperties.Description="Zamknij szczegóły parafii"
                        Style="{StaticResource TextButtonStyle}"
                        WidthRequest="44">
                        <Button.ImageSource>
                            <FontImageSource
                                Color="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                FontFamily="{StaticResource FontIcons}"
                                Glyph="{StaticResource IconCircleX}"
                                Size="24" />
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Command="{Binding OpenReviewsCommand}"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        Style="{StaticResource TonalButtonStyle}"
                        Text="Oceny i komentarze" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding NavigateCommand}"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        Text="Nawiguj" />
                </Grid>

                <Button
                    Command="{Binding AddFeedbackCommand}"
                    HorizontalOptions="Fill"
                    Style="{StaticResource TextButtonStyle}"
                    Text="Dodaj opinię o procesie w tej parafii" />

                <Label
                    IsVisible="{Binding HasExternalActionError}"
                    Style="{StaticResource ErrorLabelStyle}"
                    Text="{Binding ExternalActionError}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</base:BasePage>