<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Appostazja.Maui.Views.AboutView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Appostazja.Maui.ViewModels"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    android:NavigationBar.Color="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
    android:NavigationBar.Style="{AppThemeBinding Light=DarkContent, Dark=LightContent}"
    Title="Info"
    x:DataType="vm:AboutViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            ApplyOn="OnPageNavigatedTo"
            StatusBarColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="20">
            <Border Style="{StaticResource PrimaryContainerCardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Image HeightRequest="52" HorizontalOptions="Start" WidthRequest="52">
                        <Image.Source>
                            <FontImageSource
                                Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                FontFamily="{StaticResource FontIcons}"
                                Glyph="{StaticResource IconInfoCircle}"
                                Size="48" />
                        </Image.Source>
                    </Image>
                    <Label Style="{StaticResource HeadlineSmallStyle}" Text="Świadoma decyzja,&#x0a;czytelny proces"
                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                    <Label Style="{StaticResource BodyMediumStyle}"
                           Text="Aplikacja pomaga przygotować dokument i znaleźć parafię. Nie zastępuje aktualnej informacji prawnej ani kanonicznej."
                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource TitleLargeStyle}" Text="Przed złożeniem dokumentu" />

            <Border Style="{StaticResource ElevatedCardStyle}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image HeightRequest="30" WidthRequest="30">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconFileCheck}"
                                    Size="28" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Sprawdź dane i treść" />
                            <Label Style="{StaticResource BodyMediumStyle}"
                                   Text="Deklaracja powinna jednoznacznie wyrażać świadomą i dobrowolną wolę wystąpienia." />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image HeightRequest="30" WidthRequest="30">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconBuildingChurch}"
                                    Size="28" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Właściwa parafia" />
                            <Label Style="{StaticResource BodyMediumStyle}"
                                   Text="Pisemne oświadczenie składa się proboszczowi parafii miejsca zamieszkania." />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image HeightRequest="30" WidthRequest="30">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconFileText}"
                                    Size="28" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Wydruk i podpis" />
                            <Label Style="{StaticResource BodyMediumStyle}"
                                   Text="Wygenerowany PDF wydrukuj, podpisz odręcznie i złóż osobiście. Jeśli wymagane, dołącz świadectwo chrztu." />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource TitleMediumStyle}" Text="Prywatność" />
                    <Label Style="{StaticResource BodyMediumStyle}"
                           Text="Dane formularza nie są wysyłane do serwera. PDF powstaje lokalnie i jest przekazywany wyłącznie do systemowego arkusza udostępniania." />
                </VerticalStackLayout>
            </Border>

            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image HeightRequest="32" WidthRequest="32">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconMessagePlus}"
                                    Size="30" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label
                                Style="{StaticResource TitleMediumStyle}"
                                Text="Podziel się przebiegiem apostazji" />
                            <Label
                                Style="{StaticResource BodyMediumStyle}"
                                Text="Twoja opinia może pomóc innym osobom przygotować się do wizyty w parafii."
                                TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button
                        Command="{Binding AddFeedbackCommand}"
                        HorizontalOptions="Fill"
                        Text="Dodaj opinię o procesie" />
                    <Label
                        Style="{StaticResource ErrorLabelStyle}"
                        Text="{Binding FeedbackError}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label HorizontalTextAlignment="Center" Style="{StaticResource SupportingTextStyle}"
                       Text="{Binding AppVersion, Mode=OneTime}" />
                <Label HorizontalTextAlignment="Center" Style="{StaticResource SupportingTextStyle}"
                       Text="{Binding MauiVersion, Mode=OneTime}" />
                <Label HorizontalTextAlignment="Center" Style="{StaticResource SupportingTextStyle}"
                       Text="{Binding BuildConfiguration, Mode=OneTime}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>