<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Appostazja.Maui.Views.MainView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Appostazja.Maui.ViewModels"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    android:NavigationBar.Color="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
    android:NavigationBar.Style="{AppThemeBinding Light=DarkContent, Dark=LightContent}"
    Title="Start"
    x:DataType="vm:MainViewModel">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            ApplyOn="OnPageNavigatedTo"
            StatusBarColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="20">
            <Border Style="{StaticResource PrimaryContainerCardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label
                            Style="{StaticResource DisplaySmallStyle}"
                            Text="Twoja decyzja.&#x0a;Jasna procedura."
                            TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                        <Label
                            Style="{StaticResource BodyMediumStyle}"
                            Text="Znajdź parafię i przygotuj deklarację PDF bez przekazywania danych na serwer."
                            TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" HeightRequest="64" WidthRequest="64" VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource
                                Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                FontFamily="{StaticResource FontIcons}"
                                Glyph="{StaticResource IconFileCheck}"
                                Size="56" />
                        </Image.Source>
                    </Image>
                </Grid>
            </Border>

            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image HeightRequest="36" WidthRequest="36">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconMessagePlus}"
                                    Size="34" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label
                                Style="{StaticResource TitleLargeStyle}"
                                Text="Jak przebiegła Twoja apostazja?"
                                TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}" />
                            <Label
                                Style="{StaticResource BodyMediumStyle}"
                                Text="Podziel się doświadczeniem i pomóż kolejnym osobom."
                                TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button
                        Command="{Binding AddFeedbackCommand}"
                        HorizontalOptions="Fill"
                        Text="Dodaj opinię o przebiegu apostazji" />
                    <Label
                        IsVisible="{Binding HasFeedbackError}"
                        Style="{StaticResource ErrorLabelStyle}"
                        Text="{Binding FeedbackError}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource TitleLargeStyle}" Text="Co chcesz zrobić?" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    SemanticProperties.Description="Otwórz mapę parafii"
                    Style="{StaticResource ElevatedCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Image HeightRequest="38" HorizontalOptions="Start" WidthRequest="38">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconMapPin}"
                                    Size="34" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource TitleMediumStyle}" Text="Mapa parafii" />
                        <Label Style="{StaticResource SupportingTextStyle}" Text="Publiczne dane z Mapy Apostazji." />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    SemanticProperties.Description="Otwórz kreator deklaracji"
                    Style="{StaticResource ElevatedCardStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFormCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Image HeightRequest="38" HorizontalOptions="Start" WidthRequest="38">
                            <Image.Source>
                                <FontImageSource
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    FontFamily="{StaticResource FontIcons}"
                                    Glyph="{StaticResource IconFileText}"
                                    Size="34" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource TitleMediumStyle}" Text="Kreator PDF" />
                        <Label Style="{StaticResource SupportingTextStyle}" Text="Dokument powstaje lokalnie na urządzeniu." />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource ElevatedCardStyle}">
                <VerticalStackLayout Spacing="16">
                    <Label Style="{StaticResource TitleLargeStyle}" Text="Jak to działa" />

                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                        <Border Padding="0" HeightRequest="32" WidthRequest="32"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label FontFamily="{StaticResource NunitoBold}" HorizontalTextAlignment="Center" Text="1"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Uzupełnij dane" />
                            <Label Style="{StaticResource SupportingTextStyle}" Text="Dane pozostają wyłącznie na urządzeniu." />
                        </VerticalStackLayout>

                        <Border Grid.Row="1" Padding="0" HeightRequest="32" WidthRequest="32"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label FontFamily="{StaticResource NunitoBold}" HorizontalTextAlignment="Center" Text="2"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Wygeneruj PDF" />
                            <Label Style="{StaticResource SupportingTextStyle}" Text="Sprawdź dokument przed wydrukowaniem." />
                        </VerticalStackLayout>

                        <Border Grid.Row="2" Padding="0" HeightRequest="32" WidthRequest="32"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <Label FontFamily="{StaticResource NunitoBold}" HorizontalTextAlignment="Center" Text="3"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                            <Label Style="{StaticResource TitleMediumStyle}" Text="Podpisz i złóż osobiście" />
                            <Label Style="{StaticResource SupportingTextStyle}" Text="Aktualną procedurę znajdziesz w zakładce Info." />
                        </VerticalStackLayout>
                    </Grid>

                    <Button
                        Command="{Binding NavigateToAboutCommand}"
                        HorizontalOptions="Start"
                        Style="{StaticResource TextButtonStyle}"
                        Text="Dowiedz się więcej" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>