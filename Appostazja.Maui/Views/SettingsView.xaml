<ContentPage
    x:Class="Appostazja.Maui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Appostazja.Maui.ViewModels"
    Title="Ustawienia"
    Padding="8"
    x:DataType="vm:SettingsViewModel">

    <VerticalStackLayout Spacing="4" VerticalOptions="End">
        <Label HorizontalOptions="End" Text="{Binding MauiVersion, Mode=OneTime}" />
        <Label HorizontalOptions="End" Text="{Binding AppVersion, Mode=OneTime}" />
    </VerticalStackLayout>


</ContentPage>