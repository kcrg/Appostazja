  <ItemGroup>
    <ProjectReference Include="..\Appostazja.Core\Appostazja.Core.csproj" />
    <None Include="..\Appostazja.Maui\Resources\Fonts\Nunito-Regular.ttf"
          Link="Nunito-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
