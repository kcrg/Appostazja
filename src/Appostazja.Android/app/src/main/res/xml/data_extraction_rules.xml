<?xml version="1.0" encoding="utf-8"?>
<!-- The declaration draft and archive hold personal data encrypted with a key that never leaves the device:
     nothing goes to cloud backups or a device-to-device transfer (android:allowBackup only covers Android 11
     and lower). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
