<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: lets the app reach a local API over plain HTTP in the same Wi-Fi network.
     Release builds keep the platform default (cleartext blocked). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
